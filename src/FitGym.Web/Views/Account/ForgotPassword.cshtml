@inject FitGym.Application.Features.Organization.IOrganizationService OrganizationService
@{ Layout = null; var organization = await OrganizationService.GetPublicAsync(); }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Quên mật khẩu · @organization.DisplayName</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/operations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login-roles.css" asp-append-version="true" />
</head>
<body class="operations-app login-page">
    <header class="login-topbar"><strong>@organization.DisplayName</strong><span>Hỗ trợ tài khoản</span></header>
    <main class="login-main"><section class="login-card" aria-labelledby="forgot-title">
        <h1 id="forgot-title">Quên mật khẩu</h1>
        <div class="password-help-item"><strong>Nhân viên</strong><p>Liên hệ quản lý phòng tập. Quản lý xác minh danh tính và đặt lại mật khẩu trong mục Tài khoản & nhân viên.</p></div>
        <div class="password-help-item"><strong>Quản lý</strong><p>Liên hệ đơn vị triển khai hệ thống để xác minh và khôi phục quyền truy cập.</p></div>
        <a class="btn btn-fitgym login-submit" asp-controller="Account" asp-action="Login">Quay lại đăng nhập</a>
    </section></main>
</body>
</html>
