@model FitGym.Web.Features.Accounts.AccountIndexViewModel
@using FitGym.Web.Features.Accounts
@{
    ViewData["Title"] = "Tài khoản & nhân viên";
}

<div class="page-heading">
    <div>
        <h1>Tài khoản & nhân viên</h1>
    </div>
    <a class="btn btn-fitgym" asp-action="Create">Tạo tài khoản</a>
</div>


@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}

<section class="fit-card">
    <form method="get" class="account-toolbar">
        <label class="visually-hidden" for="search">Tìm tài khoản</label>
        <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Tìm theo tên đăng nhập hoặc họ tên" />
        <button class="btn btn-outline-dark" type="submit">Tìm kiếm</button>
        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <a class="btn btn-link" asp-action="Index">Xóa lọc</a>
        }
    </form>

    @if (Model.Accounts.Count == 0)
    {
        <div class="empty-state">
            <h2>Chưa có tài khoản phù hợp</h2>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Nhân viên</th>
                        <th>Tài khoản</th>
                        <th>Chức vụ</th>
                        <th>Vai trò</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var account in Model.Accounts)
                {
                    <tr>
                        <td><strong>@(string.IsNullOrWhiteSpace(account.HoTen) ? "Chưa liên kết hồ sơ" : account.HoTen)</strong></td>
                        <td>
                            <div>@account.UserName</div>
                        </td>
                        <td>@account.ChucVu</td>
                        <td><span class="status-pill neutral">@account.Role</span></td>
                        <td>
                            <span class="status-pill @(account.TrangThai == AccountAdministrationService.ActiveStatus ? "active" : "inactive")">
                                @(account.TrangThai == AccountAdministrationService.ActiveStatus ? "Đang hoạt động" : "Ngừng hoạt động")
                            </span>
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@account.UserId">@(string.IsNullOrWhiteSpace(account.HoTen) ? "Hoàn thiện hồ sơ" : "Chỉnh sửa")</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="ResetPassword" asp-route-id="@account.UserId">Đặt lại mật khẩu</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

