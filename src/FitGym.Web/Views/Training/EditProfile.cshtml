@model FitGym.Web.Features.Training.TrainingProfileFormViewModel
@{
    ViewData["Title"] = "Cập nhật hồ sơ tập luyện";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="mb-4">
            <a asp-action="Profiles" class="text-decoration-none">← Hồ sơ tập luyện</a>
            <h1 class="h3 mt-2">@Model.HoTen</h1>
        </div>
        <form method="post" class="card shadow-sm">
            <div class="card-body p-4">
                <input asp-for="MaHoiVien" type="hidden" />
                <input asp-for="HoTen" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3"><label asp-for="MucTieu" class="form-label"></label><input asp-for="MucTieu" class="form-control" /><span asp-validation-for="MucTieu" class="text-danger"></span></div>
                <div class="mb-3"><label asp-for="TrinhDo" class="form-label"></label><input asp-for="TrinhDo" class="form-control" placeholder="Ví dụ: Mới bắt đầu, trung cấp" /><span asp-validation-for="TrinhDo" class="text-danger"></span></div>
                <div class="row g-3">
                    <div class="col-md-6"><label asp-for="SoNgayTuan" class="form-label"></label><input asp-for="SoNgayTuan" class="form-control" /><span asp-validation-for="SoNgayTuan" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="SoPhutBuoi" class="form-label"></label><input asp-for="SoPhutBuoi" class="form-control" /><span asp-validation-for="SoPhutBuoi" class="text-danger"></span></div>
                </div>
                <div class="mt-3"><label asp-for="DieuKienTap" class="form-label"></label><textarea asp-for="DieuKienTap" class="form-control" rows="3"></textarea><span asp-validation-for="DieuKienTap" class="text-danger"></span></div>
            </div>
            <div class="card-footer bg-white p-3 text-end"><button class="btn btn-fitgym" type="submit">Lưu hồ sơ</button></div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
