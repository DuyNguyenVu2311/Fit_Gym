@model FitGym.Web.Features.Organization.OrganizationViewModel
@{ ViewData["Title"] = Model.IsConfigured ? "Thông tin đơn vị" : "Thiết lập ban đầu"; }
<div class="page-heading"><div><h1>@ViewData["Title"]</h1></div></div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
<form asp-action="@(Model.IsConfigured ? "Update" : "Setup")" method="post" enctype="multipart/form-data" class="fit-card form-card">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <h2 class="section-title">Thông tin đơn vị</h2>
    <div class="form-grid">
        <div class="full-width"><label asp-for="OrganizationName" class="form-label"></label><input asp-for="OrganizationName" class="form-control" autocomplete="organization" /><span asp-validation-for="OrganizationName" class="text-danger"></span></div>
        <div><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" autocomplete="tel" /><span asp-validation-for="Phone" class="text-danger"></span></div>
        <div><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="text-danger"></span></div>
    </div>
    <hr class="my-4" />
    <h2 class="section-title">Cơ sở</h2>
    <div class="form-grid">
        <div class="full-width"><label asp-for="SiteName" class="form-label"></label><input asp-for="SiteName" class="form-control" /><span asp-validation-for="SiteName" class="text-danger"></span></div>
        <div class="full-width"><label asp-for="SiteAddress" class="form-label"></label><input asp-for="SiteAddress" class="form-control" autocomplete="street-address" /><span asp-validation-for="SiteAddress" class="text-danger"></span></div>
    </div>
    @if (Model.IsConfigured)
    {
        <hr class="my-4" /><h2 class="section-title">Nhận diện thương hiệu</h2>
        @if (Model.HasLogo) { <img class="organization-logo-preview" src="@Url.Action("Logo")" alt="Logo đơn vị hiện tại" /> }
        <div class="mt-3"><label asp-for="LogoFile" class="form-label"></label><input asp-for="LogoFile" type="file" accept="image/png,image/jpeg" class="form-control" /><span asp-validation-for="LogoFile" class="text-danger"></span></div>
        @if (Model.HasLogo) { <label class="mt-3"><input asp-for="RemoveLogo" class="form-check-input me-2" />Xóa logo hiện tại</label> }
    }
    <div class="form-actions"><a class="btn btn-outline-dark" asp-controller="Home" asp-action="Index">Về tổng quan</a><button class="btn btn-fitgym" type="submit">@(Model.IsConfigured ? "Lưu thông tin" : "Thiết lập đơn vị & cơ sở")</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
