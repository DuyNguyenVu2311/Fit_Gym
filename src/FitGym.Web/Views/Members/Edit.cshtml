@model FitGym.Web.Features.Members.MemberFormViewModel
@{ ViewData["Title"] = "Chỉnh sửa hội viên"; }
<div class="page-heading compact"><div><p class="eyebrow">HV-@Model.MaHoiVien.ToString("D5")</p><h1>Chỉnh sửa hồ sơ</h1></div></div>
<form asp-action="Edit" method="post" class="fit-card form-card">
    <input asp-for="MaHoiVien" type="hidden" />
    <partial name="_Form" model="Model" />
    <div class="form-actions"><a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.MaHoiVien">Hủy</a><button class="btn btn-fitgym" type="submit">Lưu thay đổi</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
