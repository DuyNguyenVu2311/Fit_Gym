@model FitGym.Application.Features.Members.MemberDetail
@using FitGym.Application.Features.Members
@{
    ViewData["Title"] = "Chi tiết hội viên";
}

<div class="page-heading">
    <div>
        <p class="eyebrow">Hồ sơ HV-@Model.MaHoiVien.ToString("D5")</p>
        <h1>@Model.HoTen</h1>
        
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">Danh sách</a>
        <a class="btn btn-fitgym" asp-action="Edit" asp-route-id="@Model.MaHoiVien">Chỉnh sửa</a>
        @if (!Model.MaTaiKhoan.HasValue) { <a class="btn btn-outline-dark" asp-controller="MemberAccounts" asp-action="Create" asp-route-memberId="@Model.MaHoiVien">Cấp tài khoản app</a> }
        else if (User.IsInRole("QuanLy")) { <a class="btn btn-outline-dark" asp-controller="MemberAccounts" asp-action="ResetPassword" asp-route-memberId="@Model.MaHoiVien">Đặt lại mật khẩu app</a> }
    </div>
</div>

@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

<section class="fit-card detail-card">
    <div class="detail-grid">
        <div><span>Họ và tên</span><strong>@Model.HoTen</strong></div>
        <div><span>Số điện thoại</span><strong>@Model.SoDienThoai</strong></div>
        <div><span>Ngày sinh</span><strong>@(Model.NgaySinh?.ToString("dd/MM/yyyy") ?? "Chưa cung cấp")</strong></div>
        <div><span>Giới tính</span><strong>@(Model.GioiTinh ?? "Chưa cung cấp")</strong></div>
        <div><span>Địa chỉ</span><strong>@(Model.DiaChi ?? "Chưa cung cấp")</strong></div>
        <div><span>Ngày tham gia</span><strong>@Model.NgayThamGia.ToString("dd/MM/yyyy")</strong></div>
        <div><span>Tài khoản ứng dụng</span><strong>@(ViewData["MemberUserName"] as string ?? "Chưa liên kết")</strong></div>
        <div><span>Trạng thái</span><strong>@(Model.TrangThai == MemberStatuses.Active ? "Đang hoạt động" : "Ngừng hoạt động")</strong></div>
    </div>
    <div class="form-actions">
        <form asp-action="SetStatus" method="post">
            <input type="hidden" name="id" value="@Model.MaHoiVien" />
            <input type="hidden" name="status" value="@(Model.TrangThai == MemberStatuses.Active ? MemberStatuses.Inactive : MemberStatuses.Active)" />
            <button class="btn @(Model.TrangThai == MemberStatuses.Active ? "btn-outline-danger" : "btn-outline-success")" type="submit">
                @(Model.TrangThai == MemberStatuses.Active ? "Ngừng hoạt động" : "Kích hoạt lại")
            </button>
        </form>
    </div>
</section>

