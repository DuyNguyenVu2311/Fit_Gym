@model FitGym.Web.Features.Members.MemberIndexViewModel
@using FitGym.Application.Features.Members
@{
    ViewData["Title"] = "Hội viên";
}

<div class="page-heading">
    <div>
        <h1>Quản lý hội viên</h1>
    </div>
    <a class="btn btn-fitgym" asp-action="Create"><svg class="icon"><use href="#i-plus" /></svg>Đăng ký hội viên</a>
</div>

@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
<div class="metrics-grid">
    <div class="metric-card"><div class="metric-label">Hồ sơ trong kết quả</div><div class="metric-main"><strong class="metric-value">@Model.Members.Count</strong></div></div>
    <div class="metric-card"><div class="metric-label">Đang hoạt động</div><div class="metric-main"><strong class="metric-value">@Model.Members.Count(x => x.TrangThai == MemberStatuses.Active)</strong></div></div>
    <div class="metric-card"><div class="metric-label">Ngừng hoạt động</div><div class="metric-main"><strong class="metric-value">@Model.Members.Count(x => x.TrangThai == MemberStatuses.Inactive)</strong></div></div>
    <div class="metric-card"><div class="metric-label">Tham gia tháng này</div><div class="metric-main"><strong class="metric-value">@Model.Members.Count(x => x.NgayThamGia.Year == DateTime.Today.Year && x.NgayThamGia.Month == DateTime.Today.Month)</strong></div></div>
</div>
<section class="collection-toolbar">
    <form method="get" class="account-toolbar">
        <input name="search" value="@Model.Search" class="form-control" placeholder="Tìm theo họ tên hoặc số điện thoại" aria-label="Tìm hội viên" />
        <select name="status" class="form-select filter-select" aria-label="Trạng thái">
            <option value="">Tất cả trạng thái</option>
            <option value="@MemberStatuses.Active" selected="@(Model.Status == MemberStatuses.Active)">Đang hoạt động</option>
            <option value="@MemberStatuses.Inactive" selected="@(Model.Status == MemberStatuses.Inactive)">Ngừng hoạt động</option>
        </select>
        <button class="btn btn-outline-dark" type="submit">Lọc</button>
    </form>
</section>
<section class="fit-card">
    <div class="collection-header"><strong>Danh sách hội viên</strong><span class="text-secondary">Hiển thị @Model.Members.Count kết quả</span></div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Mã</th><th>Họ tên</th><th>Số điện thoại</th><th>Ngày tham gia</th><th>Trạng thái</th><th></th></tr></thead>
                <tbody>
                @if (Model.Members.Count == 0)
                {
                    <tr><td colspan="6"><div class="empty-state"><svg class="icon"><use href="#i-users" /></svg><h2>Chưa có hội viên phù hợp</h2><a class="btn btn-fitgym" asp-action="Create">Thêm hội viên</a></div></td></tr>
                }
                @foreach (var member in Model.Members)
                {
                    <tr>
                        <td>HV-@member.MaHoiVien.ToString("D5")</td>
                        <td><div class="record-name"><span class="avatar">@string.Concat(member.HoTen.Split(' ', StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(x => x[0]))</span><div><strong>@member.HoTen</strong></div></div></td>
                        <td>@member.SoDienThoai</td>
                        <td>@member.NgayThamGia.ToString("dd/MM/yyyy")</td>
                        <td><span class="status-pill @(member.TrangThai == MemberStatuses.Active ? "active" : "inactive")">@(member.TrangThai == MemberStatuses.Active ? "Đang hoạt động" : "Ngừng hoạt động")</span></td>
                        <td class="text-end"><a class="btn btn-sm btn-outline-dark" asp-action="Details" asp-route-id="@member.MaHoiVien">Xem hồ sơ</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
</section>

