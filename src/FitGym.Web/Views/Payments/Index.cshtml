@model FitGym.Web.Features.Payments.PaymentIndexViewModel
@using FitGym.Application.Features.Registrations
@using System.Globalization
@{ ViewData["Title"] = "Thanh toán gói tập"; var filter = Model.Filter; var result = Model.Result; }
<div class="work-page">
<div class="page-heading work-heading"><div><h1>Thanh toán gói tập</h1></div><a class="btn btn-outline-dark" asp-controller="Registrations" asp-action="Index">Xem đăng ký</a></div>
<div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
<section class="fit-card work-panel mb-3">
    <form method="get" class="account-toolbar work-toolbar work-payment-toolbar">
        <div><label for="payment-from" class="form-label">Từ ngày</label><input id="payment-from" name="from" type="date" value="@filter.From?.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <div><label for="payment-to" class="form-label">Đến ngày</label><input id="payment-to" name="to" type="date" value="@filter.To?.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <div class="flex-grow-1"><label for="payment-search" class="form-label">Tìm giao dịch</label><input id="payment-search" name="search" value="@filter.Search" maxlength="100" class="form-control" placeholder="Tên hội viên, gói tập hoặc mã yêu cầu" /></div>
        <div><label for="payment-method" class="form-label">Phương thức</label><select id="payment-method" name="method" class="form-select"><option value="">Tất cả</option><option value="TienMat" selected="@(filter.Method == PaymentMethods.Cash)">Tiền mặt</option><option value="QR" selected="@(filter.Method == PaymentMethods.Qr)">QR</option></select></div>
        <div><label for="payment-status" class="form-label">Trạng thái</label><select id="payment-status" name="status" class="form-select"><option value="">Tất cả</option><option value="ThanhCong" selected="@(filter.Status == PaymentStatuses.Succeeded)">Đã thanh toán</option><option value="ChoThanhToan" selected="@(filter.Status == PaymentStatuses.Pending)">Chờ thanh toán</option><option value="ThatBai" selected="@(filter.Status == PaymentStatuses.Failed)">Thất bại</option></select></div>
        <button class="btn btn-outline-dark align-self-end" type="submit">Lọc</button><a class="btn btn-outline-secondary align-self-end" asp-action="Index">Xóa bộ lọc</a>
    </form>
    <div class="collection-header work-list-header"><strong>Giao dịch</strong><span>@result.TotalCount kết quả</span></div>
    <div class="table-responsive"><table class="table work-table align-middle mb-0"><thead><tr><th>Mã</th><th>Hội viên / gói tập</th><th>Thời điểm</th><th class="text-end">Số tiền</th><th>Phương thức</th><th>Trạng thái</th><th></th></tr></thead><tbody>
    @if (result.Items.Count == 0) { <tr><td colspan="7"><div class="empty-state"><h2>Chưa có giao dịch phù hợp</h2></div></td></tr> }
    @foreach (var item in result.Items) {
        <tr data-payment-id="@item.PaymentId"><td><a class="work-code" asp-action="Details" asp-route-id="@item.PaymentId">TT-@item.PaymentId.ToString("D6")</a></td><td><strong>@item.MemberName</strong><div class="small text-secondary">@item.PackageName · DK-@item.RegistrationId.ToString("D6")</div></td><td class="text-nowrap">@item.RecordedAtVietnam.ToString("dd/MM/yyyy HH:mm")</td><td class="text-end text-nowrap work-money">@VndMoney.Format(item.Amount)</td><td>@(item.Method == PaymentMethods.Cash ? "Tiền mặt" : item.Method == PaymentMethods.Qr ? "QR" : "Chưa xác định")</td><td><partial name="_Status" model="item.Status" /></td><td><a asp-action="Details" asp-route-id="@item.PaymentId" class="btn btn-sm btn-outline-dark">Chi tiết</a></td></tr>
    }
    </tbody></table></div>
    <div class="panel-footer"><span>Trang @result.Page</span><div class="d-flex gap-2">
        @if (result.Page > 1) { <a asp-action="Index" asp-route-page="@(result.Page - 1)" asp-route-from="@filter.From?.ToString("yyyy-MM-dd")" asp-route-to="@filter.To?.ToString("yyyy-MM-dd")" asp-route-search="@filter.Search" asp-route-method="@filter.Method" asp-route-status="@filter.Status">Trang trước</a> }
        @if ((long)result.Page * result.PageSize < result.TotalCount) { <a asp-action="Index" asp-route-page="@(result.Page + 1)" asp-route-from="@filter.From?.ToString("yyyy-MM-dd")" asp-route-to="@filter.To?.ToString("yyyy-MM-dd")" asp-route-search="@filter.Search" asp-route-method="@filter.Method" asp-route-status="@filter.Status">Trang sau</a> }
    </div></div>
</section>
</div>
