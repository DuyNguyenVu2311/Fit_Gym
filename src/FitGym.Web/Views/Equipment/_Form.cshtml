@model FitGym.Web.Features.Equipment.EquipmentFormViewModel
@using FitGym.Application.Features.Equipment
<div asp-validation-summary="ModelOnly" class="text-danger validation-summary"></div><div class="form-grid"><div><label asp-for="TenThietBi" class="form-label"></label><input asp-for="TenThietBi" class="form-control" /><span asp-validation-for="TenThietBi" class="text-danger"></span></div><div><label asp-for="PhanLoai" class="form-label"></label><input asp-for="PhanLoai" class="form-control" /><span asp-validation-for="PhanLoai" class="text-danger"></span></div><div><label asp-for="NgayMua" class="form-label"></label><input asp-for="NgayMua" class="form-control" /><span asp-validation-for="NgayMua" class="text-danger"></span></div>@if (Model.MaThietBi > 0) { <div><label asp-for="TrangThai" class="form-label"></label><select asp-for="TrangThai" class="form-select"><option value="@EquipmentStatuses.Active">Hoạt động</option><option value="@EquipmentStatuses.UnderMaintenance">Đang bảo trì</option><option value="@EquipmentStatuses.Retired">Ngừng sử dụng</option></select></div> }</div>

