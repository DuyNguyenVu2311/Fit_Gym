@model FitGym.Web.Features.Equipment.EquipmentFormViewModel
@{ ViewData["Title"] = "Chỉnh sửa thiết bị"; }
<div class="work-page">
<div class="page-heading compact work-heading"><div><h1>Chỉnh sửa @Model.TenThietBi</h1></div></div><form asp-action="Edit" method="post" class="fit-card form-card work-form-card"><input asp-for="MaThietBi" type="hidden" /><partial name="_Form" model="Model" /><div class="form-actions"><a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.MaThietBi">Hủy</a><button class="btn btn-fitgym">Lưu thay đổi</button></div></form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

