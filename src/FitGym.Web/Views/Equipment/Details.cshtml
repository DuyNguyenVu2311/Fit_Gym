@model FitGym.Application.Features.Equipment.EquipmentDetail
@using FitGym.Application.Features.Equipment
@{ ViewData["Title"] = "Chi tiết thiết bị"; }
<div class="work-page">
<div class="page-heading work-heading"><div><p class="eyebrow work-code">TB-@Model.MaThietBi.ToString("D5")</p><h1>@Model.TenThietBi</h1><p class="text-secondary mb-0">@Model.PhanLoai · mua ngày @Model.NgayMua.ToString("dd/MM/yyyy")</p></div><div class="work-heading-actions"><a class="btn btn-outline-secondary" asp-action="Index">Danh sách</a><a class="btn btn-outline-dark" asp-action="AddMaintenance" asp-route-id="@Model.MaThietBi">Ghi bảo trì</a>@if (User.IsInRole("QuanLy")) { <a class="btn btn-fitgym" asp-action="Edit" asp-route-id="@Model.MaThietBi">Chỉnh sửa</a> }</div></div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
<section class="fit-card detail-card work-detail-card mb-4"><div class="detail-grid"><div><span>Phân loại</span><strong>@Model.PhanLoai</strong></div><div><span>Ngày mua</span><strong>@Model.NgayMua.ToString("dd/MM/yyyy")</strong></div><div><span>Trạng thái</span><strong>@(Model.TrangThai == EquipmentStatuses.Active ? "Hoạt động" : Model.TrangThai == EquipmentStatuses.UnderMaintenance ? "Đang bảo trì" : "Ngừng sử dụng")</strong></div><div><span>Số lần bảo trì</span><strong>@Model.MaintenanceHistory.Count</strong></div></div></section>
<section class="fit-card work-panel"><div class="collection-header work-list-header"><strong>Lịch sử bảo trì</strong><span>@Model.MaintenanceHistory.Count lần</span></div>@if (Model.MaintenanceHistory.Count == 0) { <div class="empty-state"><h2>Chưa có lịch sử bảo trì</h2></div> } else { <div class="table-responsive"><table class="table work-table align-middle mb-0"><thead><tr><th>Ngày</th><th>Nội dung</th><th class="text-end">Chi phí</th><th>Mã nhân viên</th></tr></thead><tbody>@foreach (var item in Model.MaintenanceHistory) { <tr><td>@item.NgayBaoTri.ToString("dd/MM/yyyy")</td><td>@item.MoTa</td><td class="text-end work-money">@VndMoney.Format(item.ChiPhi)</td><td class="work-code">NV-@item.MaNhanVien.ToString("D5")</td></tr> }</tbody></table></div> }</section>
</div>

